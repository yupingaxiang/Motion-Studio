  "notUseCases": ["需要保留素材原声"],
  "aspectRatios": ["4:3"],
  "durationFrames": 156,
  "minDurationFrames": 156,
  "maxDurationFrames": 156,
  "requiredAssets": [],
  "optionalAssets": ["image", "video"],
  "params": [
    {"name":"mediaSrc","type":"string","label":"素材路径","default":"fred-examples/FLOW-001.jpg","description":"Remotion public 相对路径。"},
    {"name":"mediaType","type":"string","label":"素材类型","default":"image","description":"图片填 image，静音短视频填 video；默认时长建议用至少 4.4 秒的素材。"},
