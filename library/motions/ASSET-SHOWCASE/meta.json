    {"name":"focusX","type":"number","label":"重点左边（%）","default":0,"min":0,"max":100,"description":"百分比以展框内的素材显示区为准（包含留边）。"},
    {"name":"focusY","type":"number","label":"重点上边（%）","default":0,"min":0,"max":100},
    {"name":"focusWidth","type":"number","label":"重点宽度（%）","default":0,"min":0,"max":100,"description":"宽或高为 0 时不启用聚焦。"},
    {"name":"focusHeight","type":"number","label":"重点高度（%）","default":0,"min":0,"max":100}
